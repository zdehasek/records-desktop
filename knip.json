{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "runtime/launch.js",
    "runtime/bootstrap.js",
    "runtime/server.js",
    "runtime/src/services/ffmpeg-binaries.js",
    "scripts/*.mjs",
    "scripts/vendor/*.mjs",
    "tests/**/*.test.js"
  ],
  "project": [
    "frontend/src/**/*.{js,jsx}",
    "runtime/**/*.{js,cjs}",
    "scripts/*.mjs",
    "scripts/vendor/*.mjs",
    "desktop/electron/**/*.{js,cjs}",
    "tests/**/*.js"
  ],
  "ignoreDependencies": ["chokidar", "electron-builder"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["chromium", "magick", "omarchy", "otool"]
}
