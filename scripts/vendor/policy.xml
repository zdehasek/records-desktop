<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [<!ELEMENT policymap (policy)+><!ELEMENT policy EMPTY><!ATTLIST policy domain (delegate|coder|filter|path|resource|system) #REQUIRED name CDATA #IMPLIED pattern CDATA #IMPLIED rights CDATA #IMPLIED value CDATA #IMPLIED stealth CDATA #IMPLIED>]>
<policymap>
  <policy domain="delegate" rights="none" pattern="HTTPS"/>
  <policy domain="delegate" rights="none" pattern="HTTP"/>
  <policy domain="delegate" rights="none" pattern="URL"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="coder" rights="none" pattern="PS,PS2,PS3,EPS,PDF,XPS"/>
  <policy domain="resource" name="memory" value="1GiB"/>
  <policy domain="resource" name="map" value="2GiB"/>
  <policy domain="resource" name="disk" value="4GiB"/>
</policymap>
